# ==============================================================================
# SauronEye — Configuration File
# ==============================================================================

[general]
hostname = "production-server-01"
log_level = "info"
poll_interval_ms = 500
# Timestamp format in alerts: true for UTC (e.g. 2026-08-30 18:15:00 UTC), false for system Local time
use_utc_time = true

[database]
# Local SQLite3 database path
path = "/var/lib/sauroneye/sauron.db"
enable_wal = true
batch_flush_interval_ms = 1000

[fim]
# Backend: "auto" (prefers fanotify with fallback to inotify)
backend = "auto"
# Fingerprinting algorithm: "blake3" or "xxh3" (with scalar CPU fallback)
hash_algorithm = "blake3"

# Critical directories and files for real-time integrity monitoring
include_paths = [
    "/etc",
    "/usr/bin",
    "/usr/sbin",
    "/usr/lib",
    "/bin",
    "/sbin",
    "/boot",
    "/root/.ssh"
]

# Excluded patterns and global transient noise paths
exclude_paths = [
    "/etc/mtab",
    "/etc/resolv.conf"
]

# Distro Profile: "auto", "debian", "redhat", "alpine", "arch" or "none"
distro_profile = "auto"

[distro_exclusions]
# Debian / Ubuntu transient package manager files
debian = [
    "/var/lib/apt/lists/partial",
    "/var/cache/apt/archives/partial",
    ".apt-acquire-privs-test",
    "/var/lib/dpkg/tmp.ci",
    "/var/lib/dpkg/lock-frontend",
    "/var/lib/dpkg/lock",
    "/var/lib/apt/lists/lock"
]

# RedHat / Rocky Linux / AlmaLinux / Fedora transient files
redhat = [
    "/var/cache/dnf",
    "/var/cache/yum",
    "/var/lib/dnf/history",
    "/var/lib/rpm/.rpm.lock"
]

# Alpine Linux transient files
alpine = [
    "/var/cache/apk",
    "/lib/apk/db/lock"
]

# Arch Linux transient files
arch = [
    "/var/cache/pacman/pkg",
    "/var/lib/pacman/db.lck"
]

[package_manager]
# Automatically detects official package updates (dpkg, rpm, pacman, apk) to avoid false positives
auto_detect = true
check_package_db = true
# If true, dispatches INFO notifications for every legitimate system upgrade. If false (default), silences them.
notify_legitimate_updates = false

[auth_monitor]
enabled = true
monitor_successful_logins = true
monitor_failed_attempts = true
track_sudo_elevation = true
# Ignore periodic background cron pam_unix session opened/closed events
ignore_cron_sessions = true

[rce_detector]
enabled = true
# Protected daemons monitored against anomalous child process spawning
protected_services = [
    "nginx",
    "apache2",
    "httpd",
    "php-fpm",
    "named",
    "unbound",
    "mysqld",
    "redis-server"
]
# Strictly forbidden binaries when invoked by network service daemons
forbidden_children = [
    "/bin/sh",
    "/bin/bash",
    "/bin/dash",
    "/usr/bin/python*",
    "/usr/bin/perl",
    "/usr/bin/curl",
    "/usr/bin/wget",
    "/usr/bin/nc",
    "/usr/bin/ncat",
    "/usr/bin/socat"
]

[notifications.telegram]
enabled = false
bot_token = "YOUR_BOT_TOKEN_HERE"
chat_id = "-1001234567890"
silent = false
timeout_secs = 10

[notifications.whatsapp]
enabled = false
endpoint_url = "https://api.myserver.com/message/sendText/instance"
api_key = "YOUR_API_KEY_HERE"
recipient_number = "5511999999999"
timeout_secs = 10

[notifications.smtp]
enabled = false
host = "smtp.myserver.com"
port = 587
username = "alerts@myserver.com"
password = "SECRET_PASSWORD"
from_address = "SauronEye Sentinel <alerts@myserver.com>"
# Default recipient for automated system email alerts
to_default = "security-team@myserver.com"
use_tls = true
